MUX_SELECTOR_STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devrocket/mux"
MUX_SELECTOR_LEGACY_STATE_FILE="$HOME/.config/herdr/mux-selector"

_mux_selector_process_tree_has_command() {
  local needle="$1"
  local pid="$PPID"
  local proc_name

  while [[ "$pid" == <-> ]] && (( pid > 1 )); do
    proc_name="$(ps -o comm= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
    [[ -n "$proc_name" ]] || break
    [[ "${proc_name:t}" == "$needle" ]] && return 0
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')"
  done
  return 1
}

_mux_selector_read_file() {
  local state_file="$1"
  local mux
  [[ -f "$state_file" ]] || return 1
  IFS= read -r mux < "$state_file"
  case "$mux" in
    herdr|tmux) printf '%s\n' "$mux" ;;
    *) return 1 ;;
  esac
}

_mux_selector_read() {
  local mux
  if mux="$(_mux_selector_read_file "$MUX_SELECTOR_STATE_FILE")"; then
    printf '%s\n' "$mux"
    return 0
  fi

  if [[ ! -e "$MUX_SELECTOR_STATE_FILE" ]] && mux="$(_mux_selector_read_file "$MUX_SELECTOR_LEGACY_STATE_FILE")"; then
    _mux_selector_write_file "$mux" || return 1
    printf '%s\n' "$mux"
    return 0
  fi

  printf 'tmux\n'
}

_mux_selector_sync_runtime() {
  WM_CMD="${1:-$(_mux_selector_read)}"
}

_mux_selector_write_file() {
  local mux="$1"
  local state_dir="${MUX_SELECTOR_STATE_FILE:h}"
  local tmp_file

  mkdir -p "$state_dir" || return 1
  tmp_file="$(mktemp "$state_dir/.mux.XXXXXX")" || return 1
  if ! printf '%s\n' "$mux" > "$tmp_file" || ! mv -f "$tmp_file" "$MUX_SELECTOR_STATE_FILE"; then
    rm -f "$tmp_file"
    return 1
  fi
}

_mux_selector_write() {
  local mux="$1"
  case "$mux" in
    herdr|tmux) ;;
    *)
      printf 'Invalid multiplexer: %s\n' "$mux" >&2
      return 1
      ;;
  esac

  _mux_selector_write_file "$mux" || return 1
  _mux_selector_sync_runtime "$mux"
}

set_tmux() {
  _mux_selector_write tmux || return 1
  printf 'Multiplexer set to tmux for new shells and windows.\n'
}

set_herdr() {
  _mux_selector_write herdr || return 1
  printf 'Multiplexer set to herdr for new shells and windows.\n'
}

current_mux() {
  printf 'Current multiplexer: %s\n' "$(_mux_selector_read)"
}

wm_can_start() {
  [[ -z "${TMUX:-}" ]] || return 1
  [[ -z "${ZELLIJ:-}" ]] || return 1
  _mux_selector_process_tree_has_command herdr && return 1
  return 0
}

function start_if_needed() {
    if [[ $- == *i* ]] && command -v "$WM_CMD" >/dev/null 2>&1 && wm_can_start && [[ -t ${__p9k_fd_0:-0} ]]; then
       #exec $WM_CMD new-session -A -s "$(basename $(tty))"
        # exec $WM_CMD new-session -A -s "sdg-$(printf '%x' $(date +%s))"
          exec "$WM_CMD" <&${__p9k_fd_0:-0} >&${__p9k_fd_1:-1} 2>&${__p9k_fd_2:-2}
    fi
}

_mux_selector_sync_runtime

#plugins
plugins=(
  git
)

source $ZSH/oh-my-zsh.sh

# ── Zsh plugins (MUST load AFTER oh-my-zsh/compinit) ──────────────────────────
# zsh-autocomplete: MUST be first after compinit - it hooks into the completion system
if [[ $IS_TERMUX -eq 1 ]]; then
    source_if_exists "$PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
else
    source_if_exists "$BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
fi

# carapace: load AFTER autocomplete; prevent it from overriding Tab
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)
# Restore Tab to zsh-autocomplete after carapace clobbers it
bindkey '^I' menu-select

# fzf: load after; restore Tab afterwards since fzf --zsh also rebinds ^I
eval "$(fzf --zsh)"
# Restore Tab to zsh-autocomplete (fzf overwrites it with fzf-completion)
bindkey '^I' menu-select
bindkey '^[[Z' reverse-menu-complete   # Shift+Tab goes backwards

eval "$(zoxide init zsh)"
eval "$(atuin init zsh)"

# zsh-autosuggestions: after autocomplete (autocomplete manages its precmd order)
if [[ $IS_TERMUX -eq 1 ]]; then
    source_if_exists "$PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
else
    source_if_exists "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-syntax-highlighting: MUST be LAST - always
if [[ $IS_TERMUX -eq 1 ]]; then
    source_if_exists "$PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
    source_if_exists "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ─── Private/Local Overrides ───────────────────────────────────────────────────
# Source local config for machine-specific aliases, credentials, etc.
# This file is gitignored and never committed.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

start_if_needed

# Bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
